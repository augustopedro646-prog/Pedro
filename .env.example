DATABASE_URL=postgres://usuario:senha@localhost:5432/atpn_gestao
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
# 3001 por padrão pra não brigar com o PDV Jabá, que já usa a 3000 nessa mesma máquina.
PORT=3001

# Opcionais — só pra aba Calendário, que usa a MESMA agenda do PDV Jabá
# (tabela agenda_eventos, pra reservas/eventos aparecerem nos dois sistemas).
# Preencha rodando scripts/configurar-integracao-jaba.js uma vez. Sem isso a
# aba Calendário funciona mesmo assim, só avisando que não está integrada.
# JABA_DATABASE_URL=postgresql://postgres:<senha>@localhost:5432/pdv_jaba
# JABA_LOJA_ID=3
