# Banco da ATPN (o mesmo do sistema de gestão)
DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/atpn_gestao
PORT=3003
LOJA_ID=1

# Leitura da agenda do espaço no PDV Jabá (opcional — sem isso o robô diz que a equipe confirma a data)
JABA_DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/pdv_jaba
JABA_LOJA_ID=3

# Conta em console.anthropic.com (não é a mesma coisa que Claude.ai). Sem isso o robô não sobe.
ANTHROPIC_API_KEY=
# claude-haiku-4-5-20251001 é bem mais barato; claude-sonnet-5 (padrão) responde melhor
ANTHROPIC_MODEL=claude-sonnet-5

# MESMO valor do BOT_WEBHOOK_SECRET no .env do sistema de gestão (prova que o painel é quem está chamando)
BOT_WEBHOOK_SECRET=UMA_STRING_ALEATORIA_BEM_LONGA_AQUI

# WhatsApp pessoal de quem atende os chamados (DDI+DDD+número; vários separados por vírgula)
DONO_WHATSAPP=

# Transcrição de áudio (opcional, Groq compatível com a API da OpenAI)
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
