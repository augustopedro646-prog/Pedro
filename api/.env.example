# Porta da API
PORT=3000

# Conexão com o Postgres — em produção (nuvem) o provedor te dá essa URL pronta.
DATABASE_URL=postgresql://postgres:SENHA@localhost:5432/loja_gutto

# Chave pra assinar o token de login — gere uma string aleatória longa e mantenha
# secreta (nunca commitar o .env real). Ex.: openssl rand -hex 32
JWT_SECRET=troque-por-uma-chave-aleatoria-longa

# Loja padrão (id numérico criado pelo setup) — enquanto for só a Gutto, fica 1.
LOJA_ID=1

# NFC-e (Focus NFe) — valores do painel da Focus NFe, na empresa da Loja Gutto.
# Tokens da EMPRESA (não o token da conta). Comece em homologação (teste, sem valor fiscal).
# FOCUS_NFE_AMBIENTE=homologacao
# FOCUS_NFE_CNPJ_EMITENTE=00000000000000
# FOCUS_NFE_TOKEN_HOMOLOGACAO=
# FOCUS_NFE_TOKEN_PRODUCAO=
# Topo do DANFE impresso (cupom da NFC-e)
# NFCE_EMITENTE_NOME=LOJA GUTTO
# NFCE_EMITENTE_IE=
# NFCE_EMITENTE_ENDERECO=Rua ..., número - Bairro - Cidade/RN

# Pagamento pelo site (Mercado Pago → Suas integrações → sua aplicação → Credenciais).
# As credenciais de TESTE começam com TEST- (o site mostra "modo teste" no painel).
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=     (opcional: "Assinatura secreta" em Webhooks)

# Envio pelos Correios (Melhor Envio → Integrações → Permissões de acesso → Gerar novo token).
# MELHORENVIO_TOKEN=
# MELHORENVIO_AMBIENTE=producao   (ou sandbox pra testar)
# MELHORENVIO_EMAIL=contato@lojagutto.com.br

# Endereço do site na internet (o script do túnel preenche). Sem ele, o Pix funciona igual,
# só a confirmação demora um pouco mais (o sistema pergunta pro Mercado Pago a cada minuto).
# SITE_URL=https://lojagutto.com.br
